<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sama dengan backup_rules.xml, untuk cadangan cloud dan pindah HP. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
