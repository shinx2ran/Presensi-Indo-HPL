<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cadangan cloud dan pindah HP. Database + pengaturan ikut, foto selfie tidak. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
